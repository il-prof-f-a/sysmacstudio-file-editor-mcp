include README.md LICENSE CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md
include requirements-dev.lock run-mcp.cmd mcp-config.example.json
recursive-include .github *.md *.yml
recursive-include tests *.py
recursive-include contracts *.json
prune docs
include bridge/SysmacWcf/Program.cs
include bridge/SysmacWcf/ElevatedTransport.cs
include bridge/SysmacWcf/RuntimeRunner.cs
include bridge/SysmacRuntime/*.cs bridge/SysmacRuntime/*.js bridge/SysmacRuntime/*.mjs
recursive-include scripts *.py *.ps1
include bridge/SysmacFormats/Program.cs bridge/SysmacFormats/SysmacFormats.csproj
include bridge/SysmacFormats/NuGet.Config bridge/SysmacFormats/global.json bridge/SysmacFormats/packages.lock.json
